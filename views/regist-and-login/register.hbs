<!DOCTYPE html>
<html lang="uz">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Ro'yxatdan o'tish</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body { min-height: 100vh; display: flex; align-items: center; justify-content: center; background: #0f0f13; font-family: 'Segoe UI', system-ui, sans-serif; }
    .card { width: 100%; max-width: 420px; background: #18181f; border: 1px solid #2a2a35; border-radius: 16px; padding: 40px 36px; }
    .brand { text-align: center; margin-bottom: 32px; }
    .brand-icon { width: 48px; height: 48px; background: linear-gradient(135deg, #6c63ff, #a78bfa); border-radius: 12px; margin: 0 auto 12px; display: flex; align-items: center; justify-content: center; }
    .brand-icon svg { width: 24px; height: 24px; fill: #fff; }
    h1 { font-size: 1.5rem; font-weight: 700; color: #f0f0f5; }
    .subtitle { font-size: 0.875rem; color: #6b6b80; margin-top: 4px; }
    .field { margin-bottom: 18px; }
    label { display: block; font-size: 0.8rem; font-weight: 600; color: #9090a8; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 6px; }
    input { width: 100%; padding: 11px 14px; background: #0f0f13; border: 1px solid #2a2a35; border-radius: 8px; color: #f0f0f5; font-size: 0.95rem; outline: none; transition: border-color 0.2s; }
    input:focus { border-color: #6c63ff; }
    input::placeholder { color: #3a3a4a; }
    .btn { width: 100%; padding: 12px; margin-top: 8px; background: linear-gradient(135deg, #6c63ff, #a78bfa); color: #fff; font-size: 0.95rem; font-weight: 600; border: none; border-radius: 8px; cursor: pointer; transition: opacity 0.2s; }
    .btn:hover { opacity: 0.88; }
    .error-msg { background: #2a1a1a; border: 1px solid #5a2a2a; color: #f87171; border-radius: 8px; padding: 10px 14px; font-size: 0.85rem; margin-bottom: 18px; }
    .footer-link { text-align: center; margin-top: 20px; font-size: 0.85rem; color: #6b6b80; }
    .footer-link a { color: #a78bfa; text-decoration: none; font-weight: 600; }
    .footer-link a:hover { text-decoration: underline; }
  </style>
</head>
<body>
  <div class="card">
    <div class="brand">
      <div class="brand-icon">
        <svg viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 3c1.66 0 3 1.34 3 3s-1.34 3-3 3-3-1.34-3-3 1.34-3 3-3zm0 14.2c-2.5 0-4.71-1.28-6-3.22.03-1.99 4-3.08 6-3.08 1.99 0 5.97 1.09 6 3.08-1.29 1.94-3.5 3.22-6 3.22z"/></svg>
      </div>
      <h1>Ro'yxatdan o'tish</h1>
      <p class="subtitle">Yangi hisob yarating</p>
    </div>

    {{#if message}}
      <div class="error-msg">{{message}}</div>
    {{/if}}

    <form action="/sign-up" method="POST">
      <div class="field">
        <label for="fullName">To'liq ism</label>
        <input type="text" id="fullName" name="fullName" placeholder="Ism Familiya" required minlength="4"/>
      </div>
      <div class="field">
        <label for="email">Email</label>
        <input type="email" id="email" name="email" placeholder="example@mail.com" required/>
      </div>
      <div class="field">
        <label for="password">Parol</label>
        <input type="password" id="password" name="password" placeholder="Kamida 8 ta belgi" required minlength="8"/>
      </div>
      <button type="submit" class="btn">Ro'yxatdan o'tish</button>
    </form>

    <p class="footer-link">
      Hisobingiz bormi? <a href="/sign-in">Kirish</a>
    </p>
  </div>
</body>
</html>
