<!DOCTYPE html>
<html lang="uz">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Foydalanuvchilar Boshqaruvi - Smart Library</title>
    <link rel="stylesheet" href="/css/home-page.css">
    <link rel="stylesheet" href="/css/admin-panel.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        /* Rolni tanlash (Select) uchun chiroyli modern uslub */
        .role-select {
            padding: 0.4rem 0.8rem;
            border: 1px solid var(--border-soft);
            border-radius: 6px;
            background-color: #f8fafc;
            font-weight: 600;
            font-size: 0.85rem;
            color: var(--text-dark);
            outline: none;
            cursor: pointer;
        }
        .role-select:focus {
            border-color: #6366f1;
        }
        .role-badge {
            padding: 3px 8px;
            border-radius: 12px;
            font-size: 0.75rem;
            font-weight: 700;
            text-transform: uppercase;
        }
        .role-badge.admin { background: #fee2e2; color: #ef4444; }
        .role-badge.user { background: #e0f2fe; color: #0369a1; }
        
        .user-avatar-circle {
            width: 45px;
            height: 45px;
            border-radius: 50%;
            background: linear-gradient(135deg, #6366f1 0%, #a855f7 100%);
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 1.1rem;
            text-transform: uppercase;
            overflow: hidden;     
            position: relative;
            border: 2px solid #e2e8f0;
            transition: all 0.3s ease;
        }

        /* AKTIFFLIK STATUS CHYROQLARI */
        .status-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 4px 10px;
            border-radius: 20px;
            font-size: 0.8rem;
            font-weight: 600;
        }
        .status-badge.active {
            background-color: #dcfce7;
            color: #15803d;
        }
        .status-badge.inactive {
            background-color: #f1f5f9;
            color: #64748b;
        }
        .status-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            display: inline-block;
        }
        .status-badge.active .status-dot {
            background-color: #22c55e;
            box-shadow: 0 0 8px #22c55e;
            animation: pulse-green 2s infinite;
        }
        .status-badge.inactive .status-dot {
            background-color: #94a3b8;
        }

        /* Avatar atrofidagi yashil kontur (Faqat aktiv foydalanuvchilar uchun) */
        .avatar-container {
            position: relative;
            display: inline-block;
        }
        .avatar-container.is-active .user-avatar-circle {
            border-color: #22c55e;
            box-shadow: 0 0 6px rgba(34, 197, 94, 0.4);
        }

        @keyframes pulse-green {
            0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.7); }
            70% { transform: scale(1); box-shadow: 0 0 0 6px rgba(34, 197, 94, 0); }
            100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(34, 197, 94, 0); }
        }

        /* Konteyner ichidagi rasm */
        .user-avatar-circle img.avatar-image {
            width: 100%;
            height: 100%;
            object-fit: cover;    
            object-position: center; 
            display: block;
        }
    </style>
</head>
<body>

    <header class="main-header">
        <div class="nav-container">
            <a href="/" class="brand-logo">
                <i class="fa-solid fa-users-gear"></i> Admin<span>Users</span>
            </a>
            
            <div class="navigation-actions">
                <a href="/admin/dashboard" class="nav-link-btn"><i class="fa-solid fa-chart-pie"></i> Dashboardga qaytish</a>
                <a href="/" class="nav-link-btn"><i class="fa-solid fa-house"></i> Bosh sahifa</a>
                <a href="/auth/logout" class="logout-btn-direct" title="Chiqish"><i class="fa-solid fa-right-from-bracket"></i></a>
            </div>
        </div>
    </header>

    <main class="container">
        {{#if message}}
            <div class="message-alert">
                <div class="alert-content">
                    <i class="fa-solid fa-circle-info"></i>
                    <span>{{message}}</span>
                </div>
                <button class="close-alert" onclick="this.parentElement.remove()">&times;</button>
            </div>
        {{/if}}

        <div class="admin-card" style="width: 100%;">
            <div class="table-header-flex">
                <h3 class="panel-subtitle"><i class="fa-solid fa-users"></i> Ro'yxatdan o'tgan kitobxonlar</h3>
                
                <div class="table-search">
                    <form action="/admin/users" method="GET">
                        <input type="text" name="search" placeholder="Ism yoki email orqali..." value="{{searchQuery}}">
                    </form>
                </div>
            </div>

            <div class="table-responsive-wrapper">
                <table class="modern-admin-table">
                    <thead>
                        <tr>
                            <th style="width: 60px;">Profil</th>
                            <th>Foydalanuvchi ismi</th>
                            <th>Elektron pochta (Email)</th>
                            <th>Holati</th>
                            <th>Joriy Roli</th>
                            <th>Rolni o'zgartirish</th>
                            <th style="text-align: center;">Amallar</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#each users}}
                        <tr>
                            <td>
                                <div class="avatar-container {{#if this.isActive}}is-active{{/if}}">
                                    <div class="user-avatar-circle">
                                        {{#if this.image_url}}
                                            <img src="/uploads/users/{{this.image_url}}" class="avatar-image" alt="Avatar">
                                        {{else}}
                                            <img src="/images/default-profil-image.png" class="avatar-image" alt="Avatar">
                                        {{/if}}
                                    </div>
                                </div>
                            </td>
                            <td>
                                <div class="table-book-title">{{this.fullName}}</div>
                            </td>
                            <td class="font-mono">{{this.email}}</td>
                            <td>
                                {{#if this.isActive}}
                                    <span class="status-badge active">
                                        <span class="status-dot"></span> Faol
                                    </span>
                                {{else}}
                                    <span class="status-badge inactive">
                                        <span class="status-dot"></span> Faol emas
                                    </span>
                                {{/if}}
                            </td>
                            <td>
                                {{#if (eq this.role "ADMIN")}}
                                    <span class="role-badge admin">Admin</span>
                                {{else}}
                                    <span class="role-badge user">Kitobxon</span>
                                {{/if}}
                            </td>
                            <td>
                                <form action="/admin/users/update-role/{{this.id}}" method="POST" style="margin: 0;">
                                    <select name="role" class="role-select" onchange="this.form.submit()">
                                        <option value="USER" {{#if (eq this.role "USER")}}selected{{/if}}>Kitobxon (USER)</option>
                                        <option value="ADMIN" {{#if (eq this.role "ADMIN")}}selected{{/if}}>Admin (ADMIN)</option>
                                    </select>
                                </form>
                            </td>
                            <td>
                                <div class="table-row-actions" style="justify-content: center;">
                                    <button class="action-mini-btn delete" onclick="deleteUser('{{this.id}}', '{{this.fullName}}')" title="Foydalanuvchini o'chirish">
                                        <i class="fa-solid fa-user-minus"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                        {{else}}
                        <tr>
                            <td colspan="7" class="table-empty-row">Tizimda foydalanuvchilar topilmadi.</td>
                        </tr>
                        {{/each}}
                    </tbody>
                </table>
            </div>
        </div>
    </main>

    <script>
        function deleteUser(id, name) {
            if(confirm(`"${name}" ismli foydalanuvchini va uning barcha ma'lumotlarini tizimdan butunlay o'chirmoqchimisiz?`)) {
                window.location.href = `/admin/users/delete/${id}`;
            }
        }
    </script>
</body>
</html>