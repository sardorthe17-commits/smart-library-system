<!DOCTYPE html>
<html lang="uz">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kitobni Tahrirlash - Smart Library</title>
    <link rel="stylesheet" href="/css/home-page.css">
    <link rel="stylesheet" href="/css/admin-panel.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        .edit-layout {
            display: grid;
            grid-template-columns: 300px 1fr;
            gap: 2.5rem;
            margin-top: 2rem;
            align-items: start;
        }
        .current-cover-card {
            background: #fff;
            padding: 1.5rem;
            border-radius: 16px;
            border: 1px solid #e2e8f0;
            text-align: center;
        }
        .current-cover-card img {
            width: 100%;
            height: 380px;
            object-fit: cover;
            border-radius: 12px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.08);
            margin-bottom: 1rem;
        }
        .current-cover-title {
            font-size: 0.85rem;
            font-weight: 700;
            color: #64748b;
            text-transform: uppercase;
        }
    </style>
</head>
<body>

    <header class="main-header">
        <div class="nav-container">
            <a href="/" class="brand-logo">
                <i class="fa-solid fa-book-open-reader"></i> Kitobni<span>Tahrirlash</span>
            </a>
            
            <div class="navigation-actions">
                <a href="/admin/dashboard" class="nav-link-btn"><i class="fa-solid fa-arrow-left"></i> Dashboardga qaytish</a>
                <a href="/" class="nav-link-btn"><i class="fa-solid fa-house"></i> Bosh sahifa</a>
                <a href="/auth/logout" class="logout-btn-direct"><i class="fa-solid fa-right-from-bracket"></i></a>
            </div>
        </div>
    </header>

    <main class="container">
        
        <div class="edit-layout">
            
            <div class="current-cover-card">
                <span class="current-cover-title">Joriy muqova</span>
                <div style="margin-top: 1rem;">
                    {{#if book.coverImage}}
                        <img src="/uploads/books/{{book.coverImage}}" alt="Book Cover">
                    {{else}}
                        <img src="/images/default-cover.png" alt="No Cover">
                    {{/if}}
                </div>
                <p style="font-weight: 700; color: #0f172a; margin-top: 0.5rem;">{{book.title}}</p>
            </div>

            <div class="admin-card">
                <h3 class="panel-subtitle"><i class="fa-solid fa-pen-to-square"></i> Kitob ma'lumotlarini o'zgartirish</h3>
                
                <form action="/books/update/{{book.id}}" method="POST" enctype="multipart/form-data" class="modern-panel-form">
                    
                    <div class="panel-input-group">
                        <label>Kitob nomi</label>
                        <input type="text" name="title" value="{{book.title}}" required>
                    </div>
                    
                    <div class="panel-input-group">
                        <label>Muallif</label>
                        <input type="text" name="author" value="{{book.author}}" required>
                    </div>
                    
                    <div class="panel-input-group">
                        <label>ISBN kodi</label>
                        <input type="text" name="isbn" value="{{book.isbn}}" required>
                    </div>
                    
                    <div class="panel-form-row">
                        <div class="panel-input-group">
                            <label>Nashr yili</label>
                            <input type="number" name="publishedYear" value="{{book.publishedYear}}" required>
                        </div>
                        <div class="panel-input-group">
                            <label>Nusxa (Soni)</label>
                            <input type="number" name="availableCopies" value="{{book.availableCopies}}" required min="0">
                        </div>
                    </div>
                    
                    <div class="panel-input-group file-upload-wrapper">
                        <label>Yangi muqova yuklash (Ixtiyoriy)</label>
                        <input type="file" name="coverImage" accept="image/*">
                    </div>
                    
                    <div style="display: flex; gap: 12px; margin-top: 15px;">
                        <button type="submit" class="panel-submit-btn" style="flex: 1; margin: 0;">O'zgarishlarni saqlash</button>
                        <a href="/admin/dashboard" class="nav-link-btn" style="justify-content: center; align-items: center;">Bekor qilish</a>
                    </div>
                </form>
            </div>

        </div>
    </main>

</body>
</html>